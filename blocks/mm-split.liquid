{%- doc -%}
  A two-column region with a photograph on one side and copy on the other,
  used for the brand story and the gifting band. Compositional: the copy is
  supplied as child blocks through `content`.

  @param {string} [class] - Extra utilities for the section.
  @param {string} [attributes] - Extra attributes for the section.
  @param {image} [fallback_image] - Shown until the merchant picks an image.
  @param {boolean} [reverse] - Put the image on the reading-end side.
  @param {boolean} [dark] - Use the oxblood background instead of blush.

  @example
  {% block 'mm-split', fallback_image: image, reverse: true %}...{% endblock %}
{%- enddoc -%}
{%- assign split_image = image | default: fallback_image -%}
{% style %}
  .mms { background: #F2DFD8; color: #2E0A0E; }
  .mms--dark { background: #2E0A0E; color: #FBF6F3; }
  .mms__grid { max-width: 1280px; margin-inline: auto; padding: clamp(56px, 7vw, 104px) max(20px, 4vw); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .mms--rev .mms__media { order: 2; }
  .mms__media { overflow: hidden; border-radius: 16px; aspect-ratio: 4 / 5; max-height: 640px; justify-self: center; width: min(100%, 520px); background: #E9CFC6; }
  .mms__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mms__copy { display: grid; gap: 18px; justify-items: start; max-width: 520px; }
  .mms__copy h2 { font-family: var(--font-heading); font-size: clamp(2rem, 1.3rem + 2.4vw, 3.3rem); line-height: 1.08; text-wrap: balance; }
  .mms__copy p { line-height: 1.75; opacity: .88; }
  .mms__copy .mms-over { letter-spacing: .22em; color: #8C3A43; }
  .mms--dark .mms__copy .mms-over { color: #E2BE9C; }
  .mms__copy ul { display: grid; gap: 10px; padding: 0; margin: 4px 0 0; list-style: none; }
  .mms__copy li { padding-inline-start: 26px; position: relative; }
  .mms__copy li::before { content: "\2726"; position: absolute; inset-inline-start: 0; color: #B07E5C; font-size: .8rem; top: .25em; }
  .mms__copy .mms-btn { margin-block-start: 8px; min-height: 48px; padding-inline: 28px; border-radius: 999px; display: inline-flex; align-items: center; background: #4F1015; color: #FBF6F3; letter-spacing: .04em; }
  .mms--dark .mms__copy .mms-btn { background: #FBF6F3; color: #4F1015; }
  @media (max-width: 860px) {
    .mms__grid { grid-template-columns: minmax(0, 1fr); }
    .mms--rev .mms__media { order: 0; }
  }
{% endstyle %}
<section class="mms{% if reverse %} mms--rev{% endif %}{% if dark %} mms--dark{% endif %} {{ class }}"{% if attributes != blank %} {{ attributes }}{% endif %}>
  <div class="mms__grid">
    <div class="mms__media">
      {%- if split_image -%}
        {{ split_image | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 45vw, 92vw', widths: '400,600,800,1100', alt: split_image.alt }}
      {%- endif -%}
    </div>
    <div class="mms__copy">{{ content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "t:mm.blocks.split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:mm.blocks.image" }
  ]
}
{% endschema %}
